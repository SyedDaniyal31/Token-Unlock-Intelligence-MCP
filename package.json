{
  "name": "token-unlock-intelligence-mcp",
  "version": "1.0.0",
  "description": "Token Unlock Intelligence MCP server",
  "main": "dist/index.js",
  "scripts": {
    "build": "node scripts/copy-sql.js && tsc",
    "start": "node dist/index.js",
    "railway:deploy": "npm run build && node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test:unlock-coverage": "npm run build && node dist/scripts/testUnlockCoverage.js",
    "import-registry": "node dist/scripts/importManualRegistry.js",
    "import-registry:file": "node dist/scripts/importManualRegistry.js src/scripts/manual_registry.csv",
    "import:registry:cmc": "node dist/scripts/importManualRegistryCmcFormat.js",
    "import:registry:paste": "ts-node src/scripts/importManualRegistryFromPaste.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ctxprotocol/sdk": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "ioredis": "^5.9.3",
    "node-cron": "^3.0.3",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
