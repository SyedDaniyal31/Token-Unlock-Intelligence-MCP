# Database (required in production)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# RPC (optional)
RPC_URL=
ETH_RPC_URL=

# Redis – distributed cache for MarketAggregator (optional but recommended for horizontal scaling)
# When set, market data is cached in Redis with 5-min TTL. When unset, cache is skipped and each request hits the API.
REDIS_URL=

# Railway: Variables → Add Variable → Name: REDIS_URL, Value: redis://default:password@host:port
# Or use Railway's Redis plugin and copy the REDIS_URL it provides.

# Optional
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
